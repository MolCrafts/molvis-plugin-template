{
  "name": "molvis-plugin",
  "version": "0.2.0",
  "description": "CLI to scaffold MolVis page plugins — npx molvis-plugin create",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "molvis-plugin": "./bin/molvis-plugin.mjs",
    "create-molvis-plugin": "./bin/molvis-plugin.mjs"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MolCrafts/molvis-plugin-template.git"
  },
  "homepage": "https://github.com/MolCrafts/molvis-plugin-template",
  "bugs": {
    "url": "https://github.com/MolCrafts/molvis-plugin-template/issues"
  },
  "keywords": [
    "molvis",
    "molcrafts",
    "plugin",
    "create",
    "scaffold",
    "cli",
    "molecular-visualization"
  ],
  "scripts": {
    "molvis-plugin": "node ./bin/molvis-plugin.mjs",
    "create": "node ./bin/molvis-plugin.mjs create",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "minimist": "^1.2.8"
  },
  "engines": {
    "node": ">=20"
